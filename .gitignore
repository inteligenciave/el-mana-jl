*.sqlite-wal
*.sqlite-shm

respaldo-*.sql

# --- Control de versiones (ver PUBLICAR.md): nunca se suben respaldos de la base ---
# (tienen nómina y datos de clientes). Las migraciones y su reversa SÍ se suben.
respaldo*
*-respaldo*
*respaldo*.sql
*.dump
*.sql.gz
*.sql.zip
.dev.vars*
*.pfx
*.p12
id_rsa*
secrets*
